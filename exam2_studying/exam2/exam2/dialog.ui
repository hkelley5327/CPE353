      <layout class="QHBoxLayout" name="horizontalLayout_3">
       <item>
        <layout class="QVBoxLayout" name="verticalLayout_6">
         <item>
          <widget class="QTextBrowser" name="textBrowser_2">
           <property name="html">
            <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Sans Serif'; font-size:12pt; font-weight:600; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; text-decoration: underline;&quot;&gt;2D Static Graphics&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;           &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;NOTE:  The goal is for your code to behave the same as the provided sample solution. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell'; font-size:11pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;A left-click of the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;postButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; object starting in &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;POST&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; mode must perform the following tasks&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(1)  Create a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QPixmap&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; object with dimensions &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;200 pixels x 200 pixels&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(2)  Fill the pixmap object with &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;Qt::darkCyan&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; color  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(3)  Create a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QPainter&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; object for the pixmap object&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(4)  Set the painter object's pen to &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;Qt::white&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; color&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;(5)  &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;Use the painter object to add &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#ff0000;&quot;&gt;YOUR LINUX ACCOUNT USERNAME&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; as &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;text&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; to the pixmap object with its top left corner at location &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;(50, 50)&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(6)  Use the painter object to add an &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;ellipse&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; which is &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; text-decoration: underline; color:#ce5c00;&quot;&gt;CENTERED&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; within the pixmap object.  The width and height must be &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;10 pixels&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; in each direction.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(7)  Use the painter object to add an &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;180 pixel x 180 pixel&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;rectangle&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; text-decoration: underline; color:#ce5c00;&quot;&gt;CENTERED&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; within the pixmap object&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(8)  Create a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QGraphicsPixmapItem&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; object and load the above &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QPixmap&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; object into the item&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(9)  Add the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QGraphicsPixmapItem &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;object holding your custom pixmap to the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; text-decoration: underline; color:#ff0000;&quot;&gt;CENTER&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; of &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;scene&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(10) The &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;postButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; text will automatically change to &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;REMOVE&lt;/span&gt;&lt;/p&gt;
