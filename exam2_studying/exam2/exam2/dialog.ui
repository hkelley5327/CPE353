      <layout class="QHBoxLayout" name="horizontalLayout_7">
       <item>
        <layout class="QVBoxLayout" name="verticalLayout_5">
         <item>
          <widget class="QTextBrowser" name="textBrowser_4">
           <property name="html">
            <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Sans Serif'; font-size:12pt; font-weight:600; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; text-decoration: underline;&quot;&gt;2D-Animatation&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;         &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;NOTE:  The goal is for your code to behave the same as the provided sample solution. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(1)  Create a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;resource file&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; for the file named &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;alabama.png&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; contained within the subdirectory named &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;images&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;Upon left-click of &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#a40000;&quot;&gt;spawnButton&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(2)  Create a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QPixmap&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object and load the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;Alabama&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; logo from the resource file into the object&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;(3)  &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;Scale&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;QPixmap&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object using the predefined constants &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;logoW&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; and &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;logoH&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; for the width and height respectively&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(4)  Create a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QGraphicsPixmapItem&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object and initialize this object using the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; text-decoration: underline; color:#a40000;&quot;&gt;scaled&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;QPixmap&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object from the previous step&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;(5)  Add the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QGraphicsPixmapItem&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;CENTERED&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; about the origin of the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;scene&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;Upon left-click of &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;timerButton &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;in the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;START&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; state with the logo visible, the rotateLogo( ) method should apply a rotation as follows&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;(6)  Use &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;rotation( )&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; method to determine the current orientation of the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QGraphicsPixmapItem&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;(7)  Increment the current rotation by the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;rateSlider&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object's current value and use &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;setRotation( ) &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;to change the orientation about &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;logo's center&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;     &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;   DO NOT CHANGE THE RANGE OR DEFAULT VALUE OF&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; rateSlider&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt; !!!    &amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;    -- The&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt; rateSlider &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;value &amp;lt; ZERO should result in COUNTERCLOCKWISE rotation&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;    -- The&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt; rateSlider &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;value == ZERO should result in NO rotation  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;    -- The&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt; rateSlider &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;value &amp;gt; ZERO should result in CLOCKWISE rotation&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;(8) The &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;timerButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object state must change to &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;STOP      &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;Upon left-click of &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;timerButton &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;in the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;STOP&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; state with the logo visible&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;(9)  Rotation of the logo &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QGraphicsPixmapItem&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object should stop and the button state must revert to &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;START&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;HINT:   The &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;QGraphicsScene&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object name is &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;scene&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;             The &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;QPushbutton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; objects are named &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;spawnButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; and &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;timerButton&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt;             The &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;QSlider&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#000000;&quot;&gt; object is named &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;rateSlider&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
