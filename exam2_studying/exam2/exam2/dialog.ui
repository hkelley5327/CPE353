         <item>
          <widget class="QTextBrowser" name="textBrowser_3">
           <property name="html">
            <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Sans Serif'; font-size:12pt; font-weight:600; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; text-decoration: underline;&quot;&gt;Qt-SQL Interface&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;         &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;NOTE:  The goal is for your code to behave the same as the provided sample solution. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell'; font-size:11pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(1)  Configure the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QSqlDatabase&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; object provided in &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;dialog.h&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; to read &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;       from an &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;SQLite&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; database&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(2)  Set the database name to be the absolute pathname  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;            /home/work/cpe353/exam2.db&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;       which is located on the ECE Department Linux systems&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(3)  Open the database &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;      The database file contains three tables which were created using the following &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;      SQL statements where&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#a40000;&quot;&gt; (X, Y)&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; represents the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; text-decoration: underline; color:#a40000;&quot;&gt;top left corner&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; of a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#a40000;&quot;&gt;circle &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;with &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;      diameter &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#a40000;&quot;&gt;d   [circle = ellipse with equal height and width]&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;        &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;CREATE TABLE mega ( x INTEGER, y INTEGER, d INTEGER );&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;        &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;CREATE TABLE nested ( x INTEGER, y INTEGER, d INTEGER );&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;         &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;CREATE TABLE bubbles ( x INTEGER, y INTEGER, d INTEGER );&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(4)  Upon a left-click of the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;loadButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;, use a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QSqlQuery&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; object and a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; text-decoration: underline; color:#a40000;&quot;&gt;loop&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; to &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;      retrieve each row from the table name specified in &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;tableEdit&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;    - -  For each row of data retrieved from the table, add a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;QGraphicsEllipseItem&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;        object to the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;scene&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; object &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; text-decoration: underline; color:#a40000;&quot;&gt;at the specified (x,y) position and dimensions&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; using &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QPen&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; color &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;Qt::white&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; and the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0617f3;&quot;&gt;QBrush&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; color &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;Qt::blue&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;    --  Be sure to erase &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#a40000;&quot;&gt;tableEdit&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; contents once you have utilized that text in your query&lt;/span&gt;&lt;/p&gt;
