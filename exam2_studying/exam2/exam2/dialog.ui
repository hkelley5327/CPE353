&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;A left-click of the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;postButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; object starting in &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;REMOVE&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; mode must perform the following tasks&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt;(11)  Remove the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#0000ff;&quot;&gt;QGraphicsPixmapItem&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; from the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt; color:#a40000;&quot;&gt;scene&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:11pt;&quot;&gt; object&lt;/span&gt;&lt;/p&gt;
