&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Cantarell'; font-size:12pt; font-weight:600; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; text-decoration: underline;&quot;&gt;Qt-SQL Interface&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;            (6 points)&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;NOTE:  The goal is for your code to behave the same as the provided sample solution (while conforming to the specified constraints). &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:11pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;(1)  Configure the &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#0617f3;&quot;&gt;QSqlDatabase&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; object provided in &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;dialog.h&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; to read &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;       from an &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;SQLite&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; database&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;(2)  &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;Set the database name&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; to be the absolute pathname  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;            /home/work/cpe353/2025exam2.db&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;       which is located on the ECE Department Linux systems&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;(3)  &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;Open the database&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;      The database file contains &lt;/span&gt;&lt;span style=&quot; font-size:11pt; text-decoration: underline;&quot;&gt;three&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; tables which were created using the following &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;      SQL statements where&lt;/span&gt;&lt;span style=&quot; color:#a40000;&quot;&gt; (X, Y)&lt;/span&gt; represents the &lt;span style=&quot; text-decoration: underline; color:#a40000;&quot;&gt;top left corner&lt;/span&gt; of a &lt;span style=&quot; color:#a40000;&quot;&gt;rectangle &lt;/span&gt;with width &lt;span style=&quot; color:#a40000;&quot;&gt;w &lt;/span&gt;and height &lt;span style=&quot; color:#a40000;&quot;&gt;h&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;            &lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;CREATE TABLE one ( x INTEGER, y INTEGER, w INTEGER, h INTEGER );&lt;/span&gt; &lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;            &lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;CREATE TABLE two ( x INTEGER, y INTEGER, w INTEGER, h INTEGER  );&lt;/span&gt; &lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;             &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;CREATE TABLE four ( x INTEGER, y INTEGER, w INTEGER, h INTEGER  );&lt;/span&gt;  &lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;(4)  Upon a left-click of the &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;loadButton&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;, use a &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#0617f3;&quot;&gt;QSqlQuery&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; object and a &lt;/span&gt;&lt;span style=&quot; font-size:11pt; text-decoration: underline; color:#a40000;&quot;&gt;loop&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; to &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;      retrieve each row from the table name specified in &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;tableEdit&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;    - -  For each row of data retrieved from the table, add a &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#0000ff;&quot;&gt;QGraphicsRectItem&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;        object to the &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;scene2&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; object &lt;/span&gt;&lt;span style=&quot; font-size:11pt; text-decoration: underline; color:#a40000;&quot;&gt;at the specified (x,y) position and dimensions&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; using &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; color:#0617f3;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;the &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#0617f3;&quot;&gt;QPen&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; color &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;Qt::white&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; and the &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#0617f3;&quot;&gt;QBrush&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; color &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;Qt::darkCyan&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;    --  Be sure to erase &lt;span style=&quot; color:#a40000;&quot;&gt;tableEdit&lt;/span&gt; contents once you have utilized that text in your query&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;    -- Additional tables / table rows may be added at grading time to the database file.    &lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;HINT:   The &lt;span style=&quot; color:#0000ff;&quot;&gt;QGraphicsScene&lt;/span&gt; object is named &lt;span style=&quot; color:#a40000;&quot;&gt;scene2&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;             The &lt;span style=&quot; color:#0000ff;&quot;&gt;QLineEdit&lt;/span&gt; object is named &lt;span style=&quot; color:#a40000;&quot;&gt;tableEdit&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;             The &lt;span style=&quot; color:#0000ff;&quot;&gt;QPushButton&lt;/span&gt; object is names &lt;span style=&quot; color:#a40000;&quot;&gt;loadButton&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; color:#ff0000;&quot;&gt;NOTE:  No Credit for Hardcoded Rectangle Dimensions or Locations !!!   &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; color:#ff0000;&quot;&gt;             Problem 2 is focused on the Qt-SQL interface.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; color:#ff0000;&quot;&gt;             Your code must retrieve a row from the table and immediately use the &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; color:#ff0000;&quot;&gt;             retrieved values to draw the item to receive credit.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;NOTE:   The &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#0000ff;&quot;&gt;QPushButton&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; object named &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;clearButton2&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; is &lt;/span&gt;&lt;span style=&quot; font-size:11pt; text-decoration: underline;&quot;&gt;already fully operational &lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;in the provided code to clear &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#cc0000;&quot;&gt;scene2&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:11pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;br /&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
