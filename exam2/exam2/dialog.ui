&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;- &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#cc0000;&quot;&gt;Problem3&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; uses the &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#0617f3;&quot;&gt;QGraphicsScene&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; object named &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;scene3&lt;/span&gt;&lt;/p&gt;
