&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;NOTE:   The &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#0000ff;&quot;&gt;QPushButton&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; object named &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#a40000;&quot;&gt;clearButton1&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; is &lt;/span&gt;&lt;span style=&quot; font-size:11pt; text-decoration: underline;&quot;&gt;already fully operational &lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;in the provided code to clear &lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#cc0000;&quot;&gt;scene1&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
