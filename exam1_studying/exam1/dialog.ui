          <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Sans Serif'; font-size:13pt; font-weight:600; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt;Topic:  Using &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#0617f3;&quot;&gt;Qt/C++ statements&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt; to interact with form widgets and modify widget properties&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell'; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt;==&amp;gt; You may use hand-written &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;Qt4-style&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt; or &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;Qt5-style&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt; connect statements on this problem &amp;lt;==&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell'; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt;Add Qt/C++ statement(s) to the files&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;dialog.h&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; font-weight:400;&quot;&gt;and/or&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;dialog.cpp &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt;to complete the following tasks.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell'; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt;(1)  Change the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;text&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt; in the indicated &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#0617f3;&quot;&gt;QLabel&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt; object with object name  &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;changeThisLabel&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt;  to the word  &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;GO&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;       ** CAPITALIZATION MATTERS !!!!&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell'; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
