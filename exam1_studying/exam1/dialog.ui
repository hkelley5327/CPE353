       <item>
        <widget class="QTextBrowser" name="textBrowser_7">
         <property name="html">
          <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Sans Serif'; font-size:13pt; font-weight:600; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;Topic:  Using &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#0000ff;&quot;&gt;Qt/C++ Statements&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; to Configure and Create &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;Modal&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; and &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;Non-Modal Popup Dialogs&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt;==&amp;gt; You may use hand-written &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;Qt4-style&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt; or &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;Qt5-style&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt; connect statements on this problem &amp;lt;==&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;Add Qt/C++ Statement(s) to the files &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#0000ff;&quot;&gt;dialog.h&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; and/or &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#0000ff;&quot;&gt;dialog.cpp&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; to complete the following tasks&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;(1)  Upon left-click of  &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;spawnModalButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;, generate a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;MODAL&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; popup dialog with the properties described in (3)&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;(2)  Upon left-click of  &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;spawnNonModalButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;, generate a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;NON-MODAL&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; popup dialog with the properties described in (3)&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;(3)  &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; text-decoration: underline;&quot;&gt;Every popup dialog spawned&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; must include the following items&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;        *  The popup dialog must utilize a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#0000ff;&quot;&gt;QVBoxLayout&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; to organize all widgets&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;        *  The popup dialog must contain a &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#0000ff;&quot;&gt;QLabel&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; object that displays a copy of any user entered text from &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;payloadEdit&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;        *  The popup dialog must contain its own &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#0000ff;&quot;&gt;QPushButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; object displaying the text &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;Close&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; which upon left-click closes only that specific popup dialog&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;        *  This &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;Close&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; button must NOT close the entire application or any other popup dialogs -- it should close only the dialog containing the button&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;(4)  Once the text from &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;payloadEdit&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;  has been placed into the popup dialog's QLabel object, erase the contents of &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;payloadEdit&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;(5)  &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt;Add code to &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;CLOSE ALL THE OPEN POPUP DIALOGS &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt; upon left-click of the &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#0617f3;&quot;&gt;QPushButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt; object named &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;closeAllPopupsButton&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;      *  closeAllPopupsButton &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#000000;&quot;&gt;must&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt; NOT &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#000000;&quot;&gt;close the entire application&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#000000;&quot;&gt;-- just&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt; ALL &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#000000;&quot;&gt;of the popups currently open&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'Cantarell';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;HINTS:   The &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#0000ff;&quot;&gt;QLineEdit&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; widget's object name is &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;payloadEdit&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;               The &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#0000ff;&quot;&gt;QPushButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; widget's object names are &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;spawnModalButton&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt; and &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;spawnNonModalButton &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell';&quot;&gt;and &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; color:#ff0000;&quot;&gt;closeAllPopupsButton&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
        </widget>
