&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt;      appearing in both   &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;changeThisLabel&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt;   and    &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;changeThisEdit&lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt;&quot;&gt;    to the word  &lt;/span&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;UAH&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Cantarell'; font-size:14pt; color:#ff0000;&quot;&gt;       ** CAPITALIZATION MATTERS !!!!&lt;/span&gt;&lt;/p&gt;
