        <widget class="QTextBrowser" name="textBrowser_4">
         <property name="html">
          <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Cantarell'; font-size:13pt; font-weight:600; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;[6 pts]  Topic:   Using &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0617f3;&quot;&gt;Qt/C++ Statements&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; to Configure &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;Signals and Slots &lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;to perform the following tasks&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:14pt; color:#ff0000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt;==&amp;gt; You may use hand-written &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;Qt4-style&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt; or &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;Qt5-style&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt; connect statements on this problem &amp;lt;==&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;Add Qt/C++ statement(s) to the files&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; font-size:14pt;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; font-size:14pt; color:#0000ff;&quot;&gt;dialog.h&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; font-size:14pt;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; font-size:14pt; font-weight:400;&quot;&gt;and/or&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; font-size:14pt;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; font-size:14pt; color:#0000ff;&quot;&gt;dialog.cpp &lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;to complete the following tasks&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;Problem 2A:  Add Qt/C++ statement(s) to initialize the value of &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;leftLabel&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; to display &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#ff0000;&quot;&gt;5&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:11pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;Problem 2B:  Add Qt/C++ statement(s) to initialize the value of &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;rightLabel&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; to display &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#ff0000;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;  (zero) &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'.Lucida Grande UI';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;Problem 2C:  Add Qt/C++ statement(s) to make the value of &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;leftLabel&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; always match the value of &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;leftDial&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:11pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;Problem 2D:  Add Qt/C++ statement(s) to make the value of &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;rightLabel&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; always match the value of &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;rightDial&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;Problem 2E:&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;Add Qt/C++ statement(s) that will maintain the correct relative values of the left dial and right dial (&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#ef2929;&quot;&gt;values must ALWAYS sum to 5&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;)  as the value of &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;leftDial&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; is adjusted&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'.Lucida Grande UI';&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;Problem 2F:&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;Add Qt/C++ statement(s) that will maintain the correct relative values of the left dial and right dial (&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#ef2929;&quot;&gt;values must ALWAYS sum to 5&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt;)  as the value of &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;rightDial&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; is adjusted&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:11pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;HINTS:   Left &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;QDial&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt; object is named &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;leftDial&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;, left QLabel object named &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;leftLabel&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;            right &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;QDial&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt; object named &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;rightDial&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt; and right QLabel object named &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;rightLabel&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;CONSTRAINTS:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;* &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#ff0000;&quot;&gt;Do NOT use the Design tool to modify the form itself or you will receive&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt; zero credit (0 points).&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;* Do NOT alter the range of values for &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#000000;&quot;&gt;rightDial &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;or&lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#000000;&quot;&gt; leftDial &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;   Both already have the range from &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#000000;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt; to &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#000000;&quot;&gt;5&lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt; inclusive&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
        </widget>
