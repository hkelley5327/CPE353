     <widget class="QWidget" name="tab_3">
      <attribute name="title">
       <string>Problem 1</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_3">
       <item>
        <widget class="QTextBrowser" name="textBrowser_9">
         <property name="html">
          <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Cantarell'; font-size:13pt; font-weight:600; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;[5 pts]  Topic:  Using &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0617f3;&quot;&gt;Qt/C++ statements&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; to modify widget properties to indicated the answers the &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;Qt Help&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; questions.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt;==&amp;gt; You may use hand-written &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;Qt4-style&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt; or &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#000000;&quot;&gt;Qt5-style&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#cc0000;&quot;&gt; connect statements on this problem &amp;lt;==&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;Add Qt/C++ statement(s) to the files&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;dialog.h&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; font-weight:400;&quot;&gt;and/or&lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI';&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'.Lucida Grande UI'; color:#0000ff;&quot;&gt;dialog.cpp &lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;to complete the following tasks.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;Problem 1A:  Write code to change the &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;value&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; in the indicated &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0617f3;&quot;&gt;QSlider&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; object with object name  &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;constructorSlider&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;  to indicate the number of &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;CONSTRUCTORS&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; in the &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;QSlider&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; data type.  Slider value ranges from &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; to &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;4&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; with starting value of &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;0   (left end of the slider)&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;Problem 1B:  Write code to change the &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;value&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; in the indicated &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0617f3;&quot;&gt;QSlider&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; object with object name  &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;destructorSlider&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;  to indicate the number of &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;DESTRUCTORS&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; in the &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;QSlider&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; data type.   Slider value ranges from &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; to &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;4&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; with starting value of &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;0  (left end of the slider)&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:14pt; color:#ff0000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;Problem 1C:  Write code to change the &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;text&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; in the indicated &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;QLabel&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; object with object name  &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt;baseClassLabel&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;  to indicate the &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;base class&lt;/span&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt; of &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#0000ff;&quot;&gt;QSlider        &lt;/span&gt;&lt;span style=&quot; font-size:14pt; color:#ff0000;&quot;&gt; ** CAPITALIZATION MATTERS !!!!&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:14pt;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
